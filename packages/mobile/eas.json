{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_HTTPS_URL": "https://api.she-raksha.org",
        "EXPO_PUBLIC_BACKEND_WSS_URL": "wss://api.she-raksha.org/ws/sos",
        "EXPO_PUBLIC_POLYGON_CHAIN_ID": "80002",
        "EXPO_PUBLIC_PINATA_GATEWAY_URL": "https://gateway.pinata.cloud",
        "EXPO_PUBLIC_SHAKE_THRESHOLD_G": "2.5",
        "EXPO_PUBLIC_FALL_IMPACT_THRESHOLD_G": "3.8",
        "EXPO_PUBLIC_RAIL_A_TIMEOUT_MS": "5000"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_HTTPS_URL": "https://api.she-raksha.org",
        "EXPO_PUBLIC_BACKEND_WSS_URL": "wss://api.she-raksha.org/ws/sos",
        "EXPO_PUBLIC_POLYGON_CHAIN_ID": "137",
        "EXPO_PUBLIC_PINATA_GATEWAY_URL": "https://gateway.pinata.cloud",
        "EXPO_PUBLIC_SHAKE_THRESHOLD_G": "2.5",
        "EXPO_PUBLIC_FALL_IMPACT_THRESHOLD_G": "3.8",
        "EXPO_PUBLIC_RAIL_A_TIMEOUT_MS": "5000"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
