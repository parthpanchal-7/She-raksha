{
  "name": "@she-raksha/mobile",
  "version": "1.0.0",
  "description": "React Native Mobile App with Hardware Triggers, TFLite Voice Classifier, 5s Vault & Offline Sync",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test --test-force-exit dist/tests/*.test.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@she-raksha/circuits": "workspace:*",
    "@she-raksha/crypto-core": "workspace:*",
    "@she-raksha/design-tokens": "workspace:*",
    "@she-raksha/schemas": "workspace:*",
    "@she-raksha/sdk": "workspace:*",
    "circomlibjs": "^0.1.7",
    "react": "^18.3.1",
    "snarkjs": "^0.7.6",
    "viem": "^2.57.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.1",
    "typescript": "^5.4.5"
  }
}
