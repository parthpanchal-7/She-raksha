{
  "name": "@she-raksha/web",
  "version": "1.0.0",
  "description": "Next.js 14 Discreet Survivor PWA, WASM ZK Bystander Prover & Police/NGO Casework Dashboard",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "tsc",
    "start": "next start -p 3000",
    "test": "node --test --test-force-exit dist/tests/*.test.js",
    "lint": "tsc --noEmit",
    "screenshots": "node dist/scripts/generateScreenshots.js"
  },
  "dependencies": {
    "@she-raksha/circuits": "workspace:*",
    "@she-raksha/crypto-core": "workspace:*",
    "@she-raksha/design-tokens": "workspace:*",
    "@she-raksha/mobile": "workspace:*",
    "@she-raksha/schemas": "workspace:*",
    "@she-raksha/sdk": "workspace:*",
    "circomlibjs": "^0.1.7",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "snarkjs": "^0.7.6",
    "viem": "^2.57.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "playwright": "^1.44.0",
    "typescript": "^5.4.5"
  }
}
