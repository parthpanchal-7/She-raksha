{
  "name": "@she-raksha/contracts",
  "version": "1.0.0",
  "description": "Polygon L2 Smart Contracts (EvidenceRegistry, ZKReportVerifier, ComplaintEscrow, SOSLog, Paymaster)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "hardhat compile && tsc",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "lint": "tsc --noEmit",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhat",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network polygonAmoy",
    "check:amoy": "hardhat run scripts/checkNetwork.ts --network polygonAmoy",
    "smoke:gasless:local": "hardhat run scripts/gaslessSmokeTest.ts --network hardhat",
    "smoke:gasless:amoy": "hardhat run scripts/gaslessSmokeTest.ts --network polygonAmoy"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "hardhat": "^2.29.1",
    "solidity-coverage": "^0.8.17",
    "typescript": "^5.4.5"
  }
}
