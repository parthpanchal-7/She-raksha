{
  "name": "@she-raksha/schemas",
  "version": "1.0.0",
  "description": "Canonical DFD Data Contracts, Zod Validators, 3NF PostGIS & SQLCipher Schemas",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/tests/schemas.test.js",
    "test:src": "node --experimental-strip-types --test src/tests/schemas.test.ts",
    "lint": "tsc --noEmit",
    "db:migrate": "node dist/migrations/runner.js"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.4.5"
  }
}
